{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/scripts/guard_commands.py\"" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/scripts/guard_paths.py\"" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python .claude/scripts/a_markdown.py:*)",
      "Bash(python .claude/scripts/smoke.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Edit(.github/**)",
      "Bash(git tag:*)",
      "Bash(git push --tags:*)",
      "Bash(gh release create:*)",
      "Bash(gh release edit:*)",
      "Bash(gh release delete:*)"
    ]
  }
}
